#!/bin/sh

inputfile=$1

lines=$(wc -l "$inputfile")
choice=$(awk -F";" '{print NR" "$1}' "$inputfile" \
| dmenu -l "$lines" -i -p "Where to search?" \
| sed -E 's/^[0-9]+ //')

[ -z "$choice" ] && exit 1

option=$(rg "^$choice;" "$inputfile")
query=""
[ -z "$option" ] || query=$(dmenu -p "Search $choice" <&-)
[ -z "$option" ] && option=$(head -n 1 $inputfile) && query=$choice

[ -z "$query" ] && exit 1

urlencoded=$(echo -n "$query" | jq -sRr @uri)
uri=$(echo "$option" | awk -F";" '{print $2}' | sed "s/%s/$urlencoded/")
args=$(echo "$option" | awk -F";" '{print $3}')
echo "$uri"
zen-browser "$args" "$uri"
